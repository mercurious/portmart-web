# Cloudflare Pages response headers (tools/build.mjs copies this into _site).
# The page reads the catalog and its media from the portmart-catalog GitHub Pages site (CORS *), and nothing
# else off its own origin. Style attributes carry the cell positions (--x/--y), hence style-src-attr.
# HSTS is set at the zone (SSL/TLS > Edge Certificates), not here.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), clipboard-write=(self), gamepad=(self)
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' https://mercurious.github.io blob: data:; media-src 'self' https://mercurious.github.io; connect-src 'self' https://mercurious.github.io; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'

/sw.js
  Cache-Control: no-cache
